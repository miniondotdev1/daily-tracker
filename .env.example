# Cloud accounts & cross-device sync (optional).
# Copy this file to ".env" (or ".env.local") and fill in the two values from
# your Supabase project -> Settings -> API Keys. Then restart the dev server.
#
# Leave these unset and the app runs exactly as before: local-only, no accounts.
#
# Use the PUBLISHABLE key (sb_publishable_... or the legacy "anon public" JWT).
# Never put the sb_secret_ / service_role key here -- every VITE_ variable is
# compiled into the public browser bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
